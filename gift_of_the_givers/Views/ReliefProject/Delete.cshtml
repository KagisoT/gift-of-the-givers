@model gift_of_the_givers.Models.ReliefProject

@{
    ViewData["Title"] = "Delete Project";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-5 text-center">

                    <div class="mb-4">

                        <i class="bi bi-exclamation-triangle-fill text-danger display-4"></i>

                    </div>

                    <h2 class="fw-bold">
                        Delete Relief Project?
                    </h2>

                    <p class="text-muted">

                        Are you sure you want to delete

                        <strong>
                            @Model.Name
                        </strong>?

                    </p>

                    <p class="small text-danger">

                        This action cannot be undone.

                    </p>


                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="ReliefProjectId" />

                        <div class="d-flex justify-content-center gap-2">

                            <button type="submit"
                                    class="btn btn-danger px-4">

                                Delete Project

                            </button>

                            <a asp-action="Details"
                               asp-route-id="@Model.ReliefProjectId"
                               class="btn btn-outline-secondary px-4">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>