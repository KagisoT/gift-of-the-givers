@model IEnumerable<gift_of_the_givers.Models.Volunteer>

@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Volunteers";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h1 class="fw-bold mb-1">
            Volunteers
        </h1>

        <p class="text-muted">
            Manage registered volunteers.
        </p>

    </div>

    <a asp-controller="Volunteer"
       asp-action="Create"
       class="btn btn-danger">

        <i class="bi bi-plus-lg me-1"></i>

        Add Volunteer

    </a>

</div>


<div class="bg-white rounded-4 border overflow-hidden">

    <div class="table-responsive">

        <table class="table table-hover align-middle mb-0">

            <thead class="table-light">

            <tr>

                <th>Name</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Skills</th>
                <th>Availability</th>
                <th>Status</th>
                <th>Registered</th>

            </tr>

            </thead>

            <tbody>

            @foreach (var volunteer in Model)
            {
                <tr>

                    <td>

                        <strong>
                            @volunteer.FirstName
                            @volunteer.LastName
                        </strong>

                    </td>

                    <td>
                        @volunteer.Email
                    </td>

                    <td>
                        @(volunteer.PhoneNumber ?? "N/A")
                    </td>

                    <td>
                        @volunteer.Skills
                    </td>

                    <td>
                        @volunteer.Availability
                    </td>

                    <td>

                        <span class="badge bg-danger-subtle text-danger">

                            @volunteer.Status

                        </span>

                    </td>

                    <td>
                        @volunteer.RegistrationDate.ToString("dd MMM yyyy")
                    </td>

                </tr>
            }

            </tbody>

        </table>

    </div>

</div>