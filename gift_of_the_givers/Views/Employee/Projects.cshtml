@model IEnumerable<gift_of_the_givers.Models.ReliefProject>

@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Relief Projects";
}

<div class="d-flex justify-content-between align-items-center mb-4">

    <div>

        <h1 class="fw-bold mb-1">
            Relief Projects
        </h1>

        <p class="text-muted">
            Manage humanitarian relief projects.
        </p>

    </div>

    <a asp-controller="ReliefProject"
       asp-action="Create"
       class="btn btn-danger">

        <i class="bi bi-plus-lg me-1"></i>

        New Project

    </a>

</div>


<div class="row g-4">

    @foreach (var project in Model)
    {
        <div class="col-lg-4 col-md-6">

            <div class="bg-white border rounded-4 p-4 h-100">

                <div class="d-flex justify-content-between">

                    <div class="project-icon">

                        <i class="bi bi-globe2"></i>

                    </div>

                    <span class="badge bg-danger-subtle text-danger">

                        @project.Status

                    </span>

                </div>


                <h5 class="fw-bold mt-3">
                    @project.Name
                </h5>


                <p class="text-muted small">

                    @project.Description

                </p>


                <div class="small text-muted">

                    <div class="mb-2">

                        <i class="bi bi-geo-alt me-2"></i>

                        @project.Location

                    </div>

                    <div>

                        <i class="bi bi-calendar me-2"></i>

                        @project.StartDate.ToString("dd MMM yyyy")

                    </div>

                </div>

            </div>

        </div>
    }

</div>