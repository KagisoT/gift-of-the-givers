@model gift_of_the_givers.Models.EmployeeDashboardViewModel

@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Employee Dashboard";
}

<div class="container-fluid">

    <!-- HEADER -->

    <div class="mb-4">

        <h1 class="fw-bold mb-1">
            Employee Dashboard
        </h1>

        <p class="text-muted mb-0">
            Manage volunteers, donations and humanitarian projects.
        </p>

    </div>


    <!-- STATISTICS -->

    <div class="row g-4 mb-4">

        <!-- Volunteers -->

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-stat-card">

                <div class="stat-card-top">

                    <div>

                        <span class="stat-label">
                            TOTAL VOLUNTEERS
                        </span>

                        <h2>
                            @Model.TotalVolunteers
                        </h2>

                    </div>

                    <div class="stat-icon red">
                        <i class="bi bi-people-fill"></i>
                    </div>

                </div>

                <div class="stat-footer">

                    <span>
                        <strong>
                            @Model.ActiveVolunteers
                        </strong>
                        active
                    </span>

                    <span>
                        @Model.PendingVolunteers pending
                    </span>

                </div>

            </div>

        </div>


        <!-- Donations -->

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-stat-card">

                <div class="stat-card-top">

                    <div>

                        <span class="stat-label">
                            DONATIONS
                        </span>

                        <h2>
                            @Model.TotalDonations
                        </h2>

                    </div>

                    <div class="stat-icon green">
                        <i class="bi bi-heart-fill"></i>
                    </div>

                </div>

                <div class="stat-footer">

                    <span>
                        Total received
                    </span>

                </div>

            </div>

        </div>


        <!-- Donation amount -->

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-stat-card">

                <div class="stat-card-top">

                    <div>

                        <span class="stat-label">
                            DONATION VALUE
                        </span>

                        <h2>
                            R @Model.TotalDonationAmount.ToString("N2")
                        </h2>

                    </div>

                    <div class="stat-icon blue">
                        <i class="bi bi-cash-stack"></i>
                    </div>

                </div>

                <div class="stat-footer">

                    <span>
                        Recorded donations
                    </span>

                </div>

            </div>

        </div>


        <!-- Projects -->

        <div class="col-xl-3 col-md-6">

            <div class="dashboard-stat-card">

                <div class="stat-card-top">

                    <div>

                        <span class="stat-label">
                            ACTIVE PROJECTS
                        </span>

                        <h2>
                            @Model.ActiveProjects
                        </h2>

                    </div>

                    <div class="stat-icon purple">
                        <i class="bi bi-globe2"></i>
                    </div>

                </div>

                <div class="stat-footer">

                    <span>
                        @Model.CompletedProjects completed
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- MAIN DASHBOARD -->

    <div class="row g-4">

        <!-- Recent Volunteers -->

        <div class="col-lg-6">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <div>

                        <h5>
                            Recent Volunteers
                        </h5>

                        <p>
                            Latest volunteer registrations
                        </p>

                    </div>

                    <a asp-action="Volunteers"
                       class="btn btn-sm btn-outline-danger">

                        View All

                    </a>

                </div>


                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead>

                        <tr>

                            <th>Name</th>
                            <th>Email</th>
                            <th>Status</th>

                        </tr>

                        </thead>

                        <tbody>

                        @if (Model.RecentVolunteers.Any())
                        {
                            foreach (var volunteer in Model.RecentVolunteers)
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            @volunteer.FirstName
                                            @volunteer.LastName
                                        </strong>

                                    </td>

                                    <td>
                                        @volunteer.Email
                                    </td>

                                    <td>

                                        <span class="status-badge">
                                            @volunteer.Status
                                        </span>

                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="3"
                                    class="text-center text-muted py-4">

                                    No volunteers registered yet.

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- Recent Donations -->

        <div class="col-lg-6">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <div>

                        <h5>
                            Recent Donations
                        </h5>

                        <p>
                            Latest contributions
                        </p>

                    </div>

                    <a asp-action="Donations"
                       class="btn btn-sm btn-outline-danger">

                        View All

                    </a>

                </div>


                <div class="table-responsive">

                    <table class="table align-middle mb-0">

                        <thead>

                        <tr>

                            <th>Amount</th>
                            <th>Currency</th>
                            <th>Type</th>

                        </tr>

                        </thead>

                        <tbody>

                        @if (Model.RecentDonations.Any())
                        {
                            foreach (var donation in Model.RecentDonations)
                            {
                                <tr>

                                    <td>

                                        <strong>
                                            @donation.Amount.ToString("N2")
                                        </strong>

                                    </td>

                                    <td>
                                        @donation.Currency
                                    </td>

                                    <td>
                                        @donation.DonationType
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="3"
                                    class="text-center text-muted py-4">

                                    No donations recorded yet.

                                </td>

                            </tr>
                        }

                        </tbody>

                    </table>

                </div>

            </div>

        </div>


        <!-- Active Projects -->

        <div class="col-lg-7">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <div>

                        <h5>
                            Active Relief Projects
                        </h5>

                        <p>
                            Currently active humanitarian projects
                        </p>

                    </div>

                    <a asp-action="Projects"
                       class="btn btn-sm btn-outline-danger">

                        View All

                    </a>

                </div>


                @if (Model.ActiveReliefProjects.Any())
                {
                    foreach (var project in Model.ActiveReliefProjects)
                    {
                        <div class="project-row">

                            <div class="project-icon">

                                <i class="bi bi-globe2"></i>

                            </div>

                            <div class="flex-grow-1">

                                <strong>
                                    @project.Name
                                </strong>

                                <small>
                                    @project.Location
                                </small>

                            </div>

                            <span class="project-status">
                                Active
                            </span>

                        </div>
                    }
                }
                else
                {
                    <div class="text-center py-5 text-muted">

                        <i class="bi bi-globe2 fs-2"></i>

                        <p class="mt-2">
                            No active relief projects.
                        </p>

                    </div>
                }

            </div>

        </div>


        <!-- Quick Actions -->

        <div class="col-lg-5">

            <div class="dashboard-card">

                <div class="dashboard-card-header">

                    <div>

                        <h5>
                            Quick Actions
                        </h5>

                        <p>
                            Manage the organisation
                        </p>

                    </div>

                </div>


                <div class="quick-actions">

                    <a asp-controller="Volunteer"
                       asp-action="Index"
                       class="quick-action">

                        <div class="quick-action-icon">

                            <i class="bi bi-people-fill"></i>

                        </div>

                        <div>

                            <strong>
                                Manage Volunteers
                            </strong>

                            <small>
                                View and manage volunteers
                            </small>

                        </div>

                        <i class="bi bi-chevron-right ms-auto"></i>

                    </a>


                    <a asp-controller="Donation"
                       asp-action="Index"
                       class="quick-action">

                        <div class="quick-action-icon">

                            <i class="bi bi-heart-fill"></i>

                        </div>

                        <div>

                            <strong>
                                Manage Donations
                            </strong>

                            <small>
                                Review donations
                            </small>

                        </div>

                        <i class="bi bi-chevron-right ms-auto"></i>

                    </a>


                    <a asp-controller="ReliefProject"
                       asp-action="Create"
                       class="quick-action">

                        <div class="quick-action-icon">

                            <i class="bi bi-plus-circle-fill"></i>

                        </div>

                        <div>

                            <strong>
                                New Relief Project
                            </strong>

                            <small>
                                Create a project
                            </small>

                        </div>

                        <i class="bi bi-chevron-right ms-auto"></i>

                    </a>

                </div>

            </div>

        </div>

    </div>

</div>


@section Styles {

<style>

    .dashboard-stat-card {
        background: white;
        border-radius: 15px;
        padding: 22px;
        border: 1px solid #eeeeee;
    }

    .stat-card-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .stat-label {
        color: #888;
        font-size: 0.68rem;
        font-weight: 800;
        letter-spacing: .7px;
    }

    .stat-card-top h2 {
        margin: 6px 0 0;
        font-weight: 800;
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.2rem;
    }

    .stat-icon.red {
        background: #fff0f2;
        color: #c8102e;
    }

    .stat-icon.green {
        background: #edf8f0;
        color: #198754;
    }

    .stat-icon.blue {
        background: #eef5ff;
        color: #0d6efd;
    }

    .stat-icon.purple {
        background: #f4efff;
        color: #6f42c1;
    }

    .stat-footer {
        display: flex;
        justify-content: space-between;
        margin-top: 18px;
        padding-top: 12px;
        border-top: 1px solid #eeeeee;
        font-size: .78rem;
        color: #888;
    }

    .dashboard-card {
        background: white;
        border: 1px solid #eeeeee;
        border-radius: 15px;
        overflow: hidden;
    }

    .dashboard-card-header {
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #eeeeee;
    }

    .dashboard-card-header h5 {
        font-weight: 800;
        margin-bottom: 3px;
    }

    .dashboard-card-header p {
        margin: 0;
        color: #888;
        font-size: .8rem;
    }

    .dashboard-card .table {
        font-size: .85rem;
    }

    .dashboard-card .table th {
        font-size: .7rem;
        color: #888;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .status-badge,
    .project-status {
        display: inline-block;
        background: #fff0f2;
        color: #c8102e;
        border-radius: 50px;
        padding: 5px 10px;
        font-size: .7rem;
        font-weight: 700;
    }

    .project-row {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 15px 20px;
        border-bottom: 1px solid #eeeeee;
    }

    .project-row:last-child {
        border-bottom: none;
    }

    .project-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #fff0f2;
        color: #c8102e;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .project-row strong {
        display: block;
        font-size: .88rem;
    }

    .project-row small {
        display: block;
        color: #888;
        margin-top: 3px;
    }

    .quick-actions {
        padding: 10px;
    }

    .quick-action {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px;
        text-decoration: none;
        color: #222;
        border-radius: 10px;
        transition: .2s ease;
    }

    .quick-action:hover {
        background: #f8f8f8;
    }

    .quick-action-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: #fff0f2;
        color: #c8102e;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .quick-action strong {
        display: block;
        font-size: .85rem;
    }

    .quick-action small {
        display: block;
        color: #888;
        margin-top: 2px;
    }

</style>

}