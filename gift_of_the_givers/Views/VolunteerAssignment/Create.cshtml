@model gift_of_the_givers.Models.VolunteerAssignment

@{
    ViewData["Title"] = "Assign Volunteer";

    var volunteers =
        ViewBag.Volunteers as List<gift_of_the_givers.Models.Volunteer>
        ?? new List<gift_of_the_givers.Models.Volunteer>();

    var projects =
        ViewBag.Projects as List<gift_of_the_givers.Models.ReliefProject>
        ?? new List<gift_of_the_givers.Models.ReliefProject>();
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="mb-4">

                <a asp-action="Index"
                   class="text-decoration-none text-muted">

                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Assignments

                </a>

            </div>

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-header bg-danger text-white border-0 p-4">

                    <h3 class="fw-bold mb-1">
                        Assign Volunteer
                    </h3>

                    <p class="mb-0 opacity-75">
                        Connect a volunteer with a relief project.
                    </p>

                </div>

                <div class="card-body p-4 p-lg-5">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>

                        <div class="mb-4">

                            <label asp-for="VolunteerId"
                                   class="form-label fw-semibold">

                                Volunteer

                            </label>

                            <select asp-for="VolunteerId"
                                    class="form-select form-select-lg">

                                <option value="">
                                    Select a volunteer
                                </option>

                                @foreach (var volunteer in volunteers)
                                {
                                    <option value="@volunteer.VolunteerId">

                                        @volunteer.FirstName
                                        @volunteer.LastName
                                        -
                                        @volunteer.Email

                                    </option>
                                }

                            </select>

                            <div class="form-text">
                                Only approved and active volunteers are shown.
                            </div>

                            <span asp-validation-for="VolunteerId"
                                  class="text-danger"></span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="ReliefProjectId"
                                   class="form-label fw-semibold">

                                Relief Project

                            </label>

                            <select asp-for="ReliefProjectId"
                                    class="form-select form-select-lg">

                                <option value="">
                                    Select a relief project
                                </option>

                                @foreach (var project in projects)
                                {
                                    <option value="@project.ReliefProjectId">

                                        @project.Name
                                        -
                                        @project.Location

                                    </option>
                                }

                            </select>

                            <div class="form-text">
                                Completed and cancelled projects are excluded.
                            </div>

                            <span asp-validation-for="ReliefProjectId"
                                  class="text-danger"></span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Role"
                                   class="form-label fw-semibold">

                                Volunteer Role

                            </label>

                            <input asp-for="Role"
                                   class="form-control form-control-lg"
                                   placeholder="e.g. Food Distribution Coordinator" />

                            <span asp-validation-for="Role"
                                  class="text-danger"></span>

                        </div>


                        <div class="alert alert-light border">

                            <i class="bi bi-info-circle text-danger me-2"></i>

                            The assignment will initially be created with
                            <strong>Assigned</strong> status.

                        </div>


                        <div class="d-flex justify-content-end gap-2 mt-4">

                            <a asp-action="Index"
                               class="btn btn-outline-secondary btn-lg">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-danger btn-lg px-4">

                                <i class="bi bi-person-plus-fill me-2"></i>
                                Assign Volunteer

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}