@model gift_of_the_givers.Models.VolunteerAssignment

@{
    ViewData["Title"] = "Edit Assignment";

    var volunteers =
        ViewBag.Volunteers as List<gift_of_the_givers.Models.Volunteer>
        ?? new List<gift_of_the_givers.Models.Volunteer>();

    var projects =
        ViewBag.Projects as List<gift_of_the_givers.Models.ReliefProject>
        ?? new List<gift_of_the_givers.Models.ReliefProject>();
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-header bg-danger text-white p-4 border-0">

                    <h3 class="fw-bold mb-1">
                        Edit Assignment
                    </h3>

                    <p class="mb-0 opacity-75">
                        Update the volunteer's project assignment.
                    </p>

                </div>

                <div class="card-body p-4 p-lg-5">

                    <form asp-action="Edit"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="VolunteerAssignmentId" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>


                        <div class="mb-4">

                            <label asp-for="VolunteerId"
                                   class="form-label fw-semibold">

                                Volunteer

                            </label>

                            <select asp-for="VolunteerId"
                                    class="form-select form-select-lg">

                                @foreach (var volunteer in volunteers)
                                {
                                    <option value="@volunteer.VolunteerId">

                                        @volunteer.FirstName
                                        @volunteer.LastName
                                        -
                                        @volunteer.Email

                                    </option>
                                }

                            </select>

                            <span asp-validation-for="VolunteerId"
                                  class="text-danger"></span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="ReliefProjectId"
                                   class="form-label fw-semibold">

                                Relief Project

                            </label>

                            <select asp-for="ReliefProjectId"
                                    class="form-select form-select-lg">

                                @foreach (var project in projects)
                                {
                                    <option value="@project.ReliefProjectId">

                                        @project.Name
                                        -
                                        @project.Location

                                    </option>
                                }

                            </select>

                            <span asp-validation-for="ReliefProjectId"
                                  class="text-danger"></span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Role"
                                   class="form-label fw-semibold">

                                Role

                            </label>

                            <input asp-for="Role"
                                   class="form-control form-control-lg" />

                            <span asp-validation-for="Role"
                                  class="text-danger"></span>

                        </div>


                        <div class="alert alert-info">

                            <i class="bi bi-info-circle-fill me-2"></i>

                            Current assignment status:
                            <strong>@Model.Status</strong>.

                            Use the assignment details page to change
                            the status.

                        </div>


                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Details"
                               asp-route-id="@Model.VolunteerAssignmentId"
                               class="btn btn-outline-secondary btn-lg">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-danger btn-lg px-4">

                                <i class="bi bi-check-lg me-1"></i>
                                Save Changes

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}