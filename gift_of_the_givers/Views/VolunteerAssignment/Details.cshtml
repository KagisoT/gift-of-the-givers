@model gift_of_the_givers.Models.VolunteerAssignment

@{
    ViewData["Title"] = "Assignment Details";

    var statusClass = Model.Status switch
    {
        gift_of_the_givers.Models.AssignmentStatus.Active
            => "bg-success",

        gift_of_the_givers.Models.AssignmentStatus.Completed
            => "bg-primary",

        gift_of_the_givers.Models.AssignmentStatus.Cancelled
            => "bg-secondary",

        _ => "bg-warning text-dark"
    };
}

<div class="container py-5">

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">

            <i class="bi bi-check-circle-fill me-2"></i>

            @TempData["SuccessMessage"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert"></button>

        </div>
    }

    <div class="row g-4">

        <!-- Volunteer -->
        <div class="col-lg-5">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4">

                    <span class="text-danger fw-semibold">
                        VOLUNTEER
                    </span>

                    <h2 class="fw-bold mt-2">

                        @Model.Volunteer?.FirstName
                        @Model.Volunteer?.LastName

                    </h2>

                    <p class="text-muted">
                        @Model.Volunteer?.Email
                    </p>

                    <hr />

                    <div class="mb-3">

                        <small class="text-muted d-block">
                            Skills
                        </small>

                        <span>
                            @Model.Volunteer?.Skills
                        </span>

                    </div>

                    <div>

                        <small class="text-muted d-block">
                            Availability
                        </small>

                        <span>
                            @Model.Volunteer?.Availability
                        </span>

                    </div>

                    <div class="mt-4">

                        <a asp-controller="Volunteer"
                           asp-action="Details"
                           asp-route-id="@Model.VolunteerId"
                           class="btn btn-outline-danger">

                            View Volunteer

                        </a>

                    </div>

                </div>

            </div>

        </div>


        <!-- Assignment -->
        <div class="col-lg-7">

            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-lg-5">

                    <div class="d-flex justify-content-between
                                align-items-start mb-4">

                        <div>

                            <span class="text-danger fw-semibold">
                                ASSIGNMENT
                            </span>

                            <h2 class="fw-bold mt-2">
                                @Model.Role
                            </h2>

                        </div>

                        <span class="badge @statusClass px-3 py-2">
                            @Model.Status
                        </span>

                    </div>

                    <div class="p-4 bg-light rounded-4 mb-4">

                        <h5 class="fw-bold">

                            <i class="bi bi-geo-alt-fill text-danger me-2"></i>

                            @Model.ReliefProject?.Name

                        </h5>

                        <p class="text-muted mb-0">

                            @Model.ReliefProject?.Location

                        </p>

                    </div>

                    <div class="row g-3 mb-4">

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3">

                                <small class="text-muted d-block">
                                    Assigned Date
                                </small>

                                <strong>
                                    @Model.AssignedDate.ToString("dd MMMM yyyy")
                                </strong>

                            </div>

                        </div>

                        <div class="col-md-6">

                            <div class="border rounded-3 p-3">

                                <small class="text-muted d-block">
                                    Assignment Status
                                </small>

                                <strong>
                                    @Model.Status
                                </strong>

                            </div>

                        </div>

                    </div>


                    <!-- Management -->
                    <h5 class="fw-bold mb-3">
                        Assignment Management
                    </h5>

                    <div class="d-flex flex-wrap gap-2">

                        @if (Model.Status == gift_of_the_givers.Models.AssignmentStatus.Assigned)
                        {
                            <form asp-action="Activate"
                                  asp-route-id="@Model.VolunteerAssignmentId"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-success">

                                    <i class="bi bi-play-fill me-1"></i>
                                    Activate

                                </button>

                            </form>
                        }

                        @if (Model.Status == gift_of_the_givers.Models.AssignmentStatus.Assigned ||
                             Model.Status == gift_of_the_givers.Models.AssignmentStatus.Active)
                        {
                            <form asp-action="Complete"
                                  asp-route-id="@Model.VolunteerAssignmentId"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-primary">

                                    <i class="bi bi-check-circle me-1"></i>
                                    Complete

                                </button>

                            </form>

                            <form asp-action="Cancel"
                                  asp-route-id="@Model.VolunteerAssignmentId"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <button type="submit"
                                        class="btn btn-warning">

                                    <i class="bi bi-x-circle me-1"></i>
                                    Cancel

                                </button>

                            </form>
                        }

                        <a asp-action="Edit"
                           asp-route-id="@Model.VolunteerAssignmentId"
                           class="btn btn-outline-danger">

                            <i class="bi bi-pencil me-1"></i>
                            Edit

                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@Model.VolunteerAssignmentId"
                           class="btn btn-outline-secondary">

                            <i class="bi bi-trash me-1"></i>
                            Delete

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="mt-4">

        <a asp-action="Index"
           class="btn btn-outline-secondary">

            <i class="bi bi-arrow-left me-1"></i>
            Back to Assignments

        </a>

    </div>

</div>