@model IEnumerable<gift_of_the_givers.Models.Volunteer>

@{
    ViewData["Title"] = "Our Volunteers";
}

<div class="container py-5">

    <!-- Hero -->
    <div class="rounded-4 p-5 mb-5 text-white"
         style="background: linear-gradient(135deg, #b30000, #e53935);">

        <div class="row align-items-center">

            <div class="col-lg-8">

                <span class="badge bg-light text-danger mb-3 px-3 py-2">
                    <i class="bi bi-people-fill me-1"></i>
                    Gift of the Givers
                </span>

                <h1 class="display-5 fw-bold">
                    Our Volunteers
                </h1>

                <p class="lead mb-0">
                    Meet the people who dedicate their time,
                    skills and compassion to helping communities
                    in need.
                </p>

            </div>

            <div class="col-lg-4 text-lg-end mt-4 mt-lg-0">

                <a asp-action="Create"
                   class="btn btn-light btn-lg rounded-pill px-4">

                    <i class="bi bi-person-plus-fill me-2"></i>
                    Become a Volunteer

                </a>

            </div>

        </div>

    </div>


    <!-- Search -->
    <div class="card border-0 shadow-sm rounded-4 mb-5">

        <div class="card-body p-4">

            <form asp-action="Index"
                  method="get">

                <div class="row g-3 align-items-end">

                    <div class="col-lg-7">

                        <label class="form-label fw-semibold">
                            Search Volunteers
                        </label>

                        <div class="input-group">

                            <span class="input-group-text bg-white">
                                <i class="bi bi-search"></i>
                            </span>

                            <input type="text"
                                   name="search"
                                   value="@ViewBag.Search"
                                   class="form-control"
                                   placeholder="Search by name, skills or availability..." />

                        </div>

                    </div>

                    <div class="col-lg-3">

                        <label class="form-label fw-semibold">
                            Status
                        </label>

                        <select name="status"
                                class="form-select">

                            <option value="">
                                All statuses
                            </option>

                            @foreach (var status in Enum.GetValues<gift_of_the_givers.Models.VolunteerStatus>())
                            {
                                if (ViewBag.Status != null &&
                                    (gift_of_the_givers.Models.VolunteerStatus)ViewBag.Status == status)
                                {
                                    <option value="@status" selected>
                                        @status
                                    </option>
                                }
                                else
                                {
                                    <option value="@status">
                                        @status
                                    </option>
                                }
                            }

                        </select>

                    </div>

                    <div class="col-lg-2">

                        <button type="submit"
                                class="btn btn-danger w-100">

                            <i class="bi bi-funnel me-1"></i>
                            Filter

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    @if (!Model.Any())
    {
        <div class="text-center py-5">

            <div class="display-1 text-muted mb-3">
                <i class="bi bi-people"></i>
            </div>

            <h3 class="fw-bold">
                No volunteers found
            </h3>

            <p class="text-muted">
                Try changing your search criteria or become
                the first volunteer.
            </p>

            <a asp-action="Create"
               class="btn btn-danger rounded-pill px-4">

                Become a Volunteer

            </a>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var volunteer in Model)
            {
                var initials =
                    $"{volunteer.FirstName.FirstOrDefault()}{volunteer.LastName.FirstOrDefault()}";

                var statusClass = volunteer.Status switch
                {
                    gift_of_the_givers.Models.VolunteerStatus.Active
                        => "bg-success",

                    gift_of_the_givers.Models.VolunteerStatus.Approved
                        => "bg-primary",

                    gift_of_the_givers.Models.VolunteerStatus.Pending
                        => "bg-warning text-dark",

                    _ => "bg-secondary"
                };

                <div class="col-md-6 col-xl-4">

                    <div class="card h-100 border-0 shadow-sm rounded-4 overflow-hidden">

                        <!-- Image -->
                        @if (!string.IsNullOrWhiteSpace(volunteer.ImageUrl))
                        {
                            <img src="@volunteer.ImageUrl"
                                 class="card-img-top"
                                 alt="@volunteer.FirstName @volunteer.LastName"
                                 style="height:240px; object-fit:cover;" />
                        }
                        else
                        {
                            <div class="d-flex align-items-center justify-content-center bg-light"
                                 style="height:240px;">

                                <div class="rounded-circle bg-danger text-white
                                            d-flex align-items-center justify-content-center
                                            fw-bold"
                                     style="width:100px;height:100px;font-size:2rem;">

                                    @initials.ToUpper()

                                </div>

                            </div>
                        }

                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between align-items-start mb-2">

                                <h4 class="fw-bold mb-0">
                                    @volunteer.FirstName
                                    @volunteer.LastName
                                </h4>

                                <span class="badge @statusClass">
                                    @volunteer.Status
                                </span>

                            </div>

                            <p class="text-muted mb-3">
                                <i class="bi bi-calendar3 me-1"></i>
                                Joined
                                @volunteer.RegistrationDate.ToString("dd MMM yyyy")
                            </p>

                            <div class="mb-3">

                                <small class="text-muted d-block mb-1">
                                    Skills
                                </small>

                                <span class="fw-semibold">
                                    @volunteer.Skills
                                </span>

                            </div>

                            <div class="mb-4">

                                <small class="text-muted d-block mb-1">
                                    Availability
                                </small>

                                <span>
                                    <i class="bi bi-clock me-1"></i>
                                    @volunteer.Availability
                                </span>

                            </div>

                            <a asp-action="Details"
                               asp-route-id="@volunteer.VolunteerId"
                               class="btn btn-outline-danger w-100">

                                View Profile
                                <i class="bi bi-arrow-right ms-1"></i>

                            </a>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>