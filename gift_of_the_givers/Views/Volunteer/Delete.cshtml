@model gift_of_the_givers.Models.Volunteer

@{
    ViewData["Title"] = "Delete Volunteer";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-body p-5 text-center">

                    <div class="rounded-circle bg-danger-subtle
                                text-danger d-flex align-items-center
                                justify-content-center mx-auto mb-4"
                         style="width:90px;height:90px;">

                        <i class="bi bi-trash3-fill fs-2"></i>

                    </div>

                    <h2 class="fw-bold">
                        Delete Volunteer
                    </h2>

                    <p class="text-muted">
                        Are you sure you want to remove this volunteer?
                        This action cannot be undone.
                    </p>

                    <div class="bg-light rounded-4 p-4 my-4">

                        <h4 class="fw-bold">
                            @Model.FirstName @Model.LastName
                        </h4>

                        <p class="text-muted mb-1">
                            @Model.Email
                        </p>

                        <span class="badge bg-secondary">
                            @Model.Status
                        </span>

                    </div>

                    @if (Model.Assignments != null &&
                         Model.Assignments.Any())
                    {
                        <div class="alert alert-warning text-start">

                            <i class="bi bi-exclamation-triangle-fill me-2"></i>

                            This volunteer has
                            <strong>@Model.Assignments.Count</strong>
                            project assignment(s).

                            Removing the volunteer may also affect
                            related assignment records depending on
                            your database relationship configuration.

                        </div>
                    }

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="VolunteerId" />

                        <div class="d-flex justify-content-center gap-3">

                            <a asp-action="Details"
                               asp-route-id="@Model.VolunteerId"
                               class="btn btn-outline-secondary btn-lg px-4">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-danger btn-lg px-4">

                                <i class="bi bi-trash me-1"></i>
                                Delete Volunteer

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>