@model gift_of_the_givers.Models.Volunteer

@{
    ViewData["Title"] = "Edit Volunteer";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-9">

            <div class="mb-4">

                <a asp-action="Details"
                   asp-route-id="@Model.VolunteerId"
                   class="text-decoration-none text-muted">

                    <i class="bi bi-arrow-left me-1"></i>
                    Back to volunteer

                </a>

            </div>

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-header bg-danger text-white p-4 border-0">

                    <h3 class="fw-bold mb-1">
                        Edit Volunteer
                    </h3>

                    <p class="mb-0 opacity-75">
                        Update volunteer information.
                    </p>

                </div>

                <div class="card-body p-4 p-lg-5">

                    <form asp-action="Edit"
                          method="post"
                          enctype="multipart/form-data">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="VolunteerId" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger"></div>

                        <div class="row g-4">

                            <div class="col-md-6">

                                <label asp-for="FirstName"
                                       class="form-label fw-semibold">
                                    First Name
                                </label>

                                <input asp-for="FirstName"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="LastName"
                                       class="form-label fw-semibold">
                                    Last Name
                                </label>

                                <input asp-for="LastName"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Email"
                                       class="form-label fw-semibold">
                                    Email
                                </label>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="Email"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="PhoneNumber"
                                       class="form-label fw-semibold">
                                    Phone Number
                                </label>

                                <input asp-for="PhoneNumber"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="PhoneNumber"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-12">

                                <label asp-for="Skills"
                                       class="form-label fw-semibold">
                                    Skills
                                </label>

                                <textarea asp-for="Skills"
                                          class="form-control"
                                          rows="4"></textarea>

                                <span asp-validation-for="Skills"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6">

                                <label asp-for="Availability"
                                       class="form-label fw-semibold">
                                    Availability
                                </label>

                                <input asp-for="Availability"
                                       class="form-control form-control-lg" />

                                <span asp-validation-for="Availability"
                                      class="text-danger"></span>

                            </div>

                            <div class="col-md-6">

                                <label class="form-label fw-semibold">
                                    Replace Profile Image
                                </label>

                                <input type="file"
                                       name="imageFile"
                                       class="form-control form-control-lg"
                                       accept=".jpg,.jpeg,.png,.webp" />

                                <small class="text-muted">
                                    Leave empty to keep the current image.
                                </small>

                            </div>

                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-5">

                            <a asp-action="Details"
                               asp-route-id="@Model.VolunteerId"
                               class="btn btn-outline-secondary btn-lg">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-danger btn-lg px-4">

                                <i class="bi bi-check-lg me-1"></i>
                                Save Changes

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}