@model gift_of_the_givers.Models.ProjectUpdate

@{
    ViewData["Title"] = "Create Project Update";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-xl-8">

            <h1 class="fw-bold">
                Create Project Update
            </h1>

            <p class="text-muted mb-4">
                Publish an update about a humanitarian project.
            </p>


            <div class="card border-0 shadow-sm rounded-4">

                <div class="card-body p-4 p-md-5">

                    <form asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>


                        <div class="mb-4">

                            <label asp-for="ReliefProjectId"
                                   class="form-label fw-semibold">

                                Relief Project

                            </label>

                            <select asp-for="ReliefProjectId"
                                    class="form-select">

                                <option value="">
                                    -- Select Project --
                                </option>

                                @foreach (var project in ViewBag.Projects)
                                {
                                    <option value="@project.ReliefProjectId">

                                        @project.Name

                                    </option>
                                }

                            </select>

                            <span asp-validation-for="ReliefProjectId"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Title"
                                   class="form-label fw-semibold">

                                Update Title

                            </label>

                            <input asp-for="Title"
                                   class="form-control"
                                   placeholder="e.g. Food distribution completed" />

                            <span asp-validation-for="Title"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="mb-4">

                            <label asp-for="Description"
                                   class="form-label fw-semibold">

                                Update Description

                            </label>

                            <textarea asp-for="Description"
                                      class="form-control"
                                      rows="7"
                                      placeholder="Describe what has happened in the project..."></textarea>

                            <span asp-validation-for="Description"
                                  class="text-danger">
                            </span>

                        </div>


                        <div class="d-flex gap-2">

                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="bi bi-send me-1"></i>

                                Publish Update

                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-secondary px-4">

                                Cancel

                            </a>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }

}