@model IEnumerable<gift_of_the_givers.Models.ProjectUpdate>

@{
    ViewData["Title"] = "Project Updates";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-5">

        <div>
            <span class="badge bg-danger-subtle text-danger mb-2">
                PROJECT PROGRESS
            </span>

            <h1 class="fw-bold mb-1">
                Project Updates
            </h1>

            <p class="text-muted mb-0">
                Follow the latest progress from our humanitarian projects.
            </p>
        </div>

        @if (User.IsInRole("Employee"))
        {
            <a asp-action="Create"
               class="btn btn-danger">

                <i class="bi bi-plus-lg me-1"></i>

                New Update

            </a>
        }

    </div>


    @if (!Model.Any())
    {
        <div class="text-center py-5">

            <i class="bi bi-newspaper display-3 text-muted"></i>

            <h4 class="mt-3">
                No updates available
            </h4>

            <p class="text-muted">
                Project updates will appear here.
            </p>

        </div>
    }
    else
    {
        <div class="row g-4">

            @foreach (var update in Model)
            {
                <div class="col-lg-6">

                    <div class="card border-0 shadow-sm rounded-4 h-100">

                        <div class="card-body p-4">

                            <div class="d-flex justify-content-between">

                                <span class="badge bg-danger-subtle text-danger">

                                    @update.ReliefProject?.Name

                                </span>

                                <small class="text-muted">

                                    @update.CreatedAt.ToString(
                                        "dd MMM yyyy")

                                </small>

                            </div>


                            <h4 class="fw-bold mt-3">

                                @update.Title

                            </h4>


                            <p class="text-muted">

                                @(update.Description.Length > 180
                                    ? update.Description.Substring(0, 180) + "..."
                                    : update.Description)

                            </p>


                            <div class="d-flex justify-content-between align-items-center">

                                <small class="text-muted">

                                    <i class="bi bi-person me-1"></i>

                                    @(update.Employee?.FirstName ?? "Employee")

                                    @(update.Employee?.LastName ?? "")

                                </small>


                                <a asp-action="Details"
                                   asp-route-id="@update.ProjectUpdateId"
                                   class="btn btn-sm btn-outline-danger">

                                    Read More

                                </a>

                            </div>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

</div>