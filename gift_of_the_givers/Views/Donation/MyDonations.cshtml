@model IEnumerable<gift_of_the_givers.Models.Donation>

@{
    ViewData["Title"] = "My Donations";
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h1 class="fw-bold mb-1">
                My Donations
            </h1>

            <p class="text-muted mb-0">
                View your donation history.
            </p>
        </div>

        <a asp-action="Create"
           class="btn btn-danger">

            <i class="bi bi-heart-fill me-2"></i>
            Make a Donation

        </a>

    </div>

    @if (!Model.Any())
    {
        <div class="card border-0 shadow-sm">

            <div class="card-body text-center py-5">

                <i class="bi bi-heart display-3 text-muted"></i>

                <h4 class="mt-3">
                    No donations yet
                </h4>

                <p class="text-muted">
                    Your donation history will appear here.
                </p>

                <a asp-action="Create"
                   class="btn btn-danger">

                    Make Your First Donation

                </a>

            </div>

        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">

                        <tr>
                            <th>Reference</th>
                            <th>Amount</th>
                            <th>Currency</th>
                            <th>Type</th>
                            <th>Date</th>
                            <th></th>
                        </tr>

                    </thead>

                    <tbody>

                        @foreach (var donation in Model)
                        {
                            <tr>

                                <td>
                                    #@donation.DonationId
                                </td>

                                <td class="fw-bold">
                                    @donation.Amount.ToString("N2")
                                </td>

                                <td>
                                    @donation.Currency
                                </td>

                                <td>
                                    @if (donation.DonationType ==
                                         gift_of_the_givers.Models.DonationType.Recurring)
                                    {
                                        <span class="badge bg-primary">
                                            Recurring
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            One-Time
                                        </span>
                                    }
                                </td>

                                <td>
                                    @donation.DonationDate
                                    .ToLocalTime()
                                    .ToString("dd MMM yyyy")
                                </td>

                                <td class="text-end">

                                    <a asp-action="Details"
                                       asp-route-id="@donation.DonationId"
                                       class="btn btn-sm btn-outline-primary">

                                        Details

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }

</div>