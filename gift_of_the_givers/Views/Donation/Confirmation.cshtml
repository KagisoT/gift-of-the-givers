@model gift_of_the_givers.Models.Donation

@{
    ViewData["Title"] = "Donation Confirmation";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-lg rounded-4 text-center">

                <div class="card-body p-5">

                    <div class="display-1 text-success mb-3">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>

                    <h1 class="fw-bold">
                        Thank You!
                    </h1>

                    <p class="lead text-muted">
                        Your donation has been successfully recorded.
                    </p>

                    <div class="card bg-light border-0 mt-4">

                        <div class="card-body text-start">

                            <div class="row mb-3">
                                <div class="col-6 text-muted">
                                    Donation ID
                                </div>

                                <div class="col-6 fw-bold text-end">
                                    #@Model.DonationId
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-6 text-muted">
                                    Amount
                                </div>

                                <div class="col-6 fw-bold text-end">
                                    @Model.Currency @Model.Amount.ToString("N2")
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-6 text-muted">
                                    Donation Type
                                </div>

                                <div class="col-6 fw-bold text-end">
                                    @Model.DonationType
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-6 text-muted">
                                    Date
                                </div>

                                <div class="col-6 fw-bold text-end">
                                    @Model.DonationDate.ToLocalTime()
                                    .ToString("dd MMM yyyy HH:mm")
                                </div>
                            </div>

                            <div class="row">
                                <div class="col-6 text-muted">
                                    Tax Certificate Reference
                                </div>

                                <div class="col-6 fw-bold text-end">
                                    @Model.TaxCertificateReference
                                </div>
                            </div>

                        </div>

                    </div>

                    <div class="d-flex justify-content-center gap-2 mt-4">

                        <a asp-action="TaxCertificate"
                           asp-route-id="@Model.DonationId"
                           class="btn btn-outline-danger">

                            <i class="bi bi-file-earmark-pdf me-2"></i>
                            Tax Certificate

                        </a>

                        <a asp-controller="Home"
                           asp-action="Index"
                           class="btn btn-danger">

                            Return Home

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>