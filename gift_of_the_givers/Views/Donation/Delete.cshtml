@model gift_of_the_givers.Models.Donation

@{
    ViewData["Title"] = "Delete Donation";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-6">

            <div class="card border-0 shadow">

                <div class="card-body p-5 text-center">

                    <div class="display-4 text-danger mb-3">
                        <i class="bi bi-exclamation-triangle-fill"></i>
                    </div>

                    <h2 class="fw-bold">
                        Delete Donation?
                    </h2>

                    <p class="text-muted">
                        Are you sure you want to delete donation
                        #@Model.DonationId?
                    </p>

                    <div class="alert alert-warning">

                        <strong>
                            @Model.Currency
                            @Model.Amount.ToString("N2")
                        </strong>

                        <br />

                        @Model.DonationType

                    </div>

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="DonationId" />

                        <div class="d-flex justify-content-center gap-2">

                            <a asp-action="Manage"
                               class="btn btn-secondary">

                                Cancel

                            </a>

                            <button type="submit"
                                    class="btn btn-danger">

                                Delete Donation

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>