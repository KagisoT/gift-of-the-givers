@model gift_of_the_givers.Models.Donation

@{
    ViewData["Title"] = "Tax Certificate";
}

<div class="container py-5">

    <div class="row justify-content-center">

        <div class="col-lg-8">

            <div class="card border-0 shadow">

                <div class="card-body p-5">

                    <div class="text-center mb-5">

                        <h2 class="fw-bold">
                            GIFT OF THE GIVERS FOUNDATION
                        </h2>

                        <p class="text-muted">
                            Donation Tax Certificate
                        </p>

                    </div>

                    <hr />

                    <div class="text-center my-5">

                        <i class="bi bi-file-earmark-check display-1 text-success"></i>

                        <h3 class="mt-3">
                            Tax Certificate Placeholder
                        </h3>

                        <p class="text-muted">
                            This page represents the tax certificate
                            functionality required by the prototype.
                        </p>

                    </div>

                    <div class="row mb-3">

                        <div class="col-6">
                            Donation Reference
                        </div>

                        <div class="col-6 fw-bold">
                            #@Model.DonationId
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-6">
                            Amount
                        </div>

                        <div class="col-6 fw-bold">
                            @Model.Currency
                            @Model.Amount.ToString("N2")
                        </div>

                    </div>

                    <div class="row mb-3">

                        <div class="col-6">
                            Donation Date
                        </div>

                        <div class="col-6 fw-bold">
                            @Model.DonationDate
                            .ToLocalTime()
                            .ToString("dd MMMM yyyy")
                        </div>

                    </div>

                    <div class="row">

                        <div class="col-6">
                            Certificate Reference
                        </div>

                        <div class="col-6 fw-bold">
                            @Model.TaxCertificateReference
                        </div>

                    </div>

                    <hr class="my-4" />

                    <div class="alert alert-info">

                        This is a prototype certificate. A production
                        implementation can generate an official PDF
                        certificate after successful payment verification.

                    </div>

                    <div class="text-center">

                        <button onclick="window.print()"
                                class="btn btn-dark">

                            <i class="bi bi-printer me-2"></i>
                            Print Certificate

                        </button>

                        <a asp-action="Details"
                           asp-route-id="@Model.DonationId"
                           class="btn btn-outline-secondary">

                            Back

                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>