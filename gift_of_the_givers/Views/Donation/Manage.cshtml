@model IEnumerable<gift_of_the_givers.Models.Donation>

@{
    ViewData["Title"] = "Manage Donations";
}

<div class="container-fluid py-4">

    <div class="mb-4">

        <h1 class="fw-bold">
            Donation Management
        </h1>

        <p class="text-muted">
            View and manage donations received by the organisation.
        </p>

    </div>

    <div class="card border-0 shadow-sm">

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-dark">

                    <tr>
                        <th>ID</th>
                        <th>Amount</th>
                        <th>Currency</th>
                        <th>Type</th>
                        <th>Date</th>
                        <th>Anonymous</th>
                        <th>Certificate</th>
                        <th>Actions</th>
                    </tr>

                </thead>

                <tbody>

                    @foreach (var donation in Model)
                    {
                        <tr>

                            <td>
                                #@donation.DonationId
                            </td>

                            <td class="fw-bold">
                                @donation.Amount.ToString("N2")
                            </td>

                            <td>
                                @donation.Currency
                            </td>

                            <td>
                                @donation.DonationType
                            </td>

                            <td>
                                @donation.DonationDate
                                .ToLocalTime()
                                .ToString("dd MMM yyyy")
                            </td>

                            <td>

                                @if (donation.IsAnonymous)
                                {
                                    <span class="badge bg-secondary">
                                        Anonymous
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        Identified
                                    </span>
                                }

                            </td>

                            <td>
                                @donation.TaxCertificateReference
                            </td>

                            <td>

                                <div class="d-flex gap-1">

                                    <a asp-action="Details"
                                       asp-route-id="@donation.DonationId"
                                       class="btn btn-sm btn-outline-primary">

                                        View

                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@donation.DonationId"
                                       class="btn btn-sm btn-outline-danger">

                                        Delete

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>