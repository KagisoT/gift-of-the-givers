@model gift_of_the_givers.Models.Donation

@{
    ViewData["Title"] = "Donate";
}

<div class="container py-5">

    <div class="row align-items-center mb-5">

        <div class="col-lg-7">

            <span class="badge bg-danger mb-3">
                SUPPORT OUR MISSION
            </span>

            <h1 class="display-4 fw-bold">
                Make a Difference Today
            </h1>

            <p class="lead text-muted">
                Your contribution helps Gift of the Givers provide
                humanitarian assistance to communities affected by
                disasters, poverty and emergencies.
            </p>

            <div class="d-flex gap-3 mt-4">

                <a asp-action="Create"
                   class="btn btn-danger btn-lg px-4">
                    <i class="bi bi-heart-fill me-2"></i>
                    Donate Now
                </a>

                <a asp-controller="Home"
                   asp-action="Index"
                   class="btn btn-outline-secondary btn-lg px-4">
                    Back Home
                </a>

            </div>

        </div>

        <div class="col-lg-5 mt-4 mt-lg-0">

            <div class="card border-0 shadow-lg rounded-4">

                <div class="card-body p-4">

                    <h4 class="fw-bold">
                        Your Donation Matters
                    </h4>

                    <hr />

                    <div class="d-flex mb-3">
                        <div class="fs-3 text-danger me-3">
                            <i class="bi bi-box-seam"></i>
                        </div>

                        <div>
                            <h6 class="fw-bold mb-1">
                                Emergency Relief
                            </h6>

                            <p class="text-muted mb-0">
                                Help provide essential supplies
                                during emergencies.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex mb-3">
                        <div class="fs-3 text-danger me-3">
                            <i class="bi bi-people"></i>
                        </div>

                        <div>
                            <h6 class="fw-bold mb-1">
                                Community Support
                            </h6>

                            <p class="text-muted mb-0">
                                Support communities in need.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex">
                        <div class="fs-3 text-danger me-3">
                            <i class="bi bi-heart"></i>
                        </div>

                        <div>
                            <h6 class="fw-bold mb-1">
                                Restore Dignity
                            </h6>

                            <p class="text-muted mb-0">
                                Help people rebuild their lives.
                            </p>
                        </div>
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>